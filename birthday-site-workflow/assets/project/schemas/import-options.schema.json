{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birthday media import options",
  "description": "Data format version 1. Additional metadata is allowed; recognized fields are validated.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "\\S",
      "description": "Editor schema reference; not fetched by build.py."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Omission means version 1. Unsupported versions are rejected."
    },
    "live_dates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:(?:01|03|05|07|08|10|12)\\.(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)\\.(?:0[1-9]|[12][0-9]|30)|02\\.(?:0[1-9]|1[0-9]|2[0-9]))(?![\\s\\S])"
      },
      "uniqueItems": true,
      "default": []
    },
    "sequence_overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "\\S",
        "allOf": [
          {
            "pattern": "^(?!\\.{1,2}$)[^/\\\\\\x00-\\x1f]+(?![\\s\\S])"
          }
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "\\S",
          "allOf": [
            {
              "pattern": "^(?!\\.{1,2}$)[^/\\\\\\x00-\\x1f]+(?![\\s\\S])"
            }
          ]
        },
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        }
      },
      "default": {},
      "description": "Source directory basename -> exact filename -> positive sequence number. Actual source number collisions are checked at import time."
    }
  },
  "additionalProperties": true
}
