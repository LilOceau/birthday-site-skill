          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "dateCalendarLead": {
          "default": "按 {year} 年的日历想一想：",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}]|\\{(?:year)\\})*(?![\\s\\S])",
