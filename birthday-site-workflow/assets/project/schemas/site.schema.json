{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Birthday site configuration",
  "description": "Data format version 1. Additional metadata is allowed; recognized fields are validated.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "pattern": "\\S",
      "description": "Editor schema reference; not fetched by build.py."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Omission means version 1. Unsupported versions are rejected."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
      "description": "Browser progress namespace. Keep stable to retain progress."
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2200
    },
    "welcomeDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:(?:01|03|05|07|08|10|12)/(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)/(?:0[1-9]|[12][0-9]|30)|02/(?:0[1-9]|1[0-9]|2[0-9]))(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ],
      "description": "Existing album MM/DD, or null/omitted. Cross-reference checked by validate_data.py."
    },
    "recipient": {
      "type": "string",
      "maxLength": 32,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "maxLength": 48,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 160,
      "pattern": "\\S"
    },
    "letterLine": {
      "type": "string",
      "maxLength": 48,
      "pattern": "\\S"
    },
    "letterDescription": {
      "type": "string",
      "maxLength": 100,
      "pattern": "\\S"
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "default": "#e7eeed",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "ink": {
          "default": "#315f69",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "accent": {
          "default": "#7295a7",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "paper": {
          "default": "#f4f3ef",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        },
        "envelope": {
          "default": "#cbd6dc",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}(?![\\s\\S])"
        }
      },
      "description": "Optional overrides; omitted fields use the documented defaults."
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": {
          "default": "assets/demo/sea.png",
          "type": "string",
          "pattern": "^assets/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+)*(?![\\s\\S])"
        },
        "motif": {
          "default": "assets/demo/botanical.svg",
          "type": "string",
          "pattern": "^assets/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+)*(?![\\s\\S])"
        },
        "texture": {
          "default": "assets/demo/paper.png",
          "type": "string",
          "pattern": "^assets/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\:?#%\\x00-\\x1f]+)*(?![\\s\\S])"
        },
        "motifAlt": {
          "default": "青绿色枝叶图案",
          "type": "string",
          "maxLength": 500
        }
      },
      "description": "Optional overrides; omitted fields use the documented defaults."
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dates": {
          "default": true,
          "type": "boolean"
        },
        "collage": {
          "default": true,
          "type": "boolean"
        },
        "quiz": {
          "default": true,
          "type": "boolean"
        }
      },
      "description": "Optional overrides; omitted fields use the documented defaults."
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistProgress": {
          "default": true,
          "type": "boolean"
        },
        "liveAutoplay": {
          "default": true,
          "type": "boolean"
        },
        "backgroundPreload": {
          "default": true,
          "type": "boolean"
        },
        "openingMotion": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "reduced"
          ]
        },
        "hintAfterAttempts": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "description": "Optional overrides; omitted fields use the documented defaults."
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageSuffix": {
          "default": "生日邀请函",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "headerRight": {
          "default": "WITH LOVE, ALWAYS",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "envelopeTop": {
          "default": "Happy",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "envelopeBottom": {
          "default": "birthday",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "letterLeftTop": {
          "default": "A SEAT",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "letterLeftBottom": {
          "default": "IN OUR",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "letterRightTop": {
          "default": "SUMMER",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "letterRightBottom": {
          "default": "STORY",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "birthdayLabel": {
          "default": "生日",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "invitationLabel": {
          "default": "邀请函",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "invitationEnglish": {
          "default": "INVITATION",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "openingLoading": {
          "default": "海风捎来了一封信",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "openingReady": {
          "default": "轻触信封，打开这份生日邀请",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "openingOpened": {
          "default": "生日邀请函已展开",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "enterButton": {
          "default": "走进这一年",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "replayButton": {
          "default": "重读这封信",
          "type": "string",
          "maxLength": 500,
