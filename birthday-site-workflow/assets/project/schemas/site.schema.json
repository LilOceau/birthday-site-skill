          "description": "Plain text. Tokens: none"
        },
        "navDates": {
          "default": "日期照片",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "navCollage": {
          "default": "拼贴照片",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "navQuiz": {
