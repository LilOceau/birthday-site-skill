          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "overviewOpen": {
          "default": "查看全部 {count} 张",
          "type": "string",
