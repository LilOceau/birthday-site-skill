          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "dateMissing": {
          "default": "这一天还没有照片，再想一个日子吧。",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "dateUnlocked": {
          "default": "日期猜对了！这一天的照片，已经为你打开。",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "dateWelcome": {
          "default": "先从这段回忆开始。其他日子，等你逐个解锁。",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[^{}])*(?![\\s\\S])",
          "description": "Plain text. Tokens: none"
        },
        "dateReset": {
          "default": "重新选一个，值得被记住的日子。",
          "type": "string",
          "maxLength": 500,
